# Copy to /etc/tlhdd/tlhdd.env on the server and replace every secret value.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tlhdd
MYSQL_USER=tlhdd_app
MYSQL_PASSWORD=replace-with-a-long-random-database-secret
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30
TLHDD_ADMIN_USER=admin
TLHDD_ADMIN_PASSWORD=replace-with-a-long-random-admin-secret
FORCE_SECURE_COOKIES=1

# Optional public API caching. Empty URL disables Redis. Set a unique prefix per environment.
TLHDD_REDIS_URL=
TLHDD_CACHE_PREFIX=tlhdd:production:public:v1
TLHDD_CACHE_TTL=60
TLHDD_SLOW_SQL_MS=200

# Optional S3-compatible publishing. Local files remain as a rollback mirror.
TLHDD_MEDIA_BACKEND=local
TLHDD_S3_ENDPOINT=
TLHDD_S3_REGION=us-east-1
TLHDD_S3_BUCKET=
TLHDD_S3_PREFIX=
TLHDD_S3_ADDRESSING_STYLE=auto
# Or use the service's instance role instead of static credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# CDN base maps to the bucket root. Include any CDN origin path here only once.
TLHDD_MEDIA_PUBLIC_BASE=
# Enable only after migration, CDN HTTPS checks and Nginx configuration update.
TLHDD_MEDIA_REDIRECT=0
